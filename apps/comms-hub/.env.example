# apps/comms-hub -- environment variables
#
# None of these are set anywhere in this repo. This build runs entirely on
# in-memory mock data (see src/lib/mock-data.ts) and never contacts a live
# BSP, email provider, or database -- see PROGRESS-comms.md "Blockers".
# Do NOT hardcode real values here or anywhere else in the codebase
# (CLAUDE.md: "Never store or hardcode credentials, API keys, or portal
# logins"). Copy to .env.local and fill in only once real accounts exist.

# --- Shared Postgres/Supabase project (same one apps/crm/apps/lead-agent
#     use -- see packages/shared-db). Needed once comms-hub's persistence
#     layer is swapped from mock data to real storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp BSP (SPEC.md module 6: Interakt, Wati, or Twilio -- pick one,
#     the WhatsAppAdapter interface in src/lib/bsp/types.ts is provider-
#     agnostic so any of the three can implement it without touching
#     call sites). Unset in this build -- getWhatsAppAdapter() falls back
#     to the mock adapter, which never contacts the network.
WHATSAPP_BSP_PROVIDER=
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_ACCOUNT_ID=

# --- Email (SPEC.md module 6: Gmail/Outlook API). Unset in this build --
#     getEmailAdapter() falls back to the mock adapter.
EMAIL_PROVIDER=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
