# Postgres connection string for the shared schema (packages/shared-db) plus
# this module's additive migration (packages/shared-db/migrations/006_developer_inventory.sql).
# Point this at the same database apps/crm/apps/lead-agent use once a human
# wires up the real shared instance; falls back to a local dev database if unset.
DATABASE_URL=

# Used only by src/tests/testHelpers.ts -- separate database so `npm run test`
# never touches dev fixtures. Falls back to a local default if unset.
TEST_DATABASE_URL=
