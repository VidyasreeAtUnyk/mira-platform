{
  "name": "@mira/inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Seller/developer inventory module (SPEC.md module 4): developer partner directory, semi-manual CSV/paste ingestion, MOU compliance tracking, buyer-demand-to-inventory matching.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli/index.ts",
    "seed": "tsx src/db/seed.ts",
    "reset-db": "tsx src/db/reset.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/tests/run.ts"
  },
  "dependencies": {
    "@mira/shared-types": "*",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "csv-parse": "^5.6.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
