# Copy to .env.local and fill in real values. Never commit .env.local.
# This app reads/writes the same shared Postgres/Supabase project as
# apps/crm and apps/lead-agent (packages/shared-db/schema.sql), plus its own
# app-local tables in db/schema.sql.

# Shared Supabase project (same instance apps/crm uses)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, used in API routes for writes that must bypass RLS. Never
# exposed to the browser. See src/lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Budget governor cap for any future AI-assisted caption generation
# (src/lib/ai/budget-governor.ts). Not wired to a live model provider yet --
# no ANTHROPIC_API_KEY / OPENAI_API_KEY exists for this module. See
# PROGRESS-social.md Blockers.
SOCIAL_AI_DAILY_CALL_CAP=20
