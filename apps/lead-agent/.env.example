OPENAI_API_KEY=sk-...
# Optional, defaults to gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini

# Postgres connection string for the shared schema (packages/shared-db).
# Point this at the same database apps/crm's Supabase project uses for the
# "shared" part of "shared schema" to be real; falls back to a local dev
# database (see packages/shared-db/README.md) if unset.
DATABASE_URL=
