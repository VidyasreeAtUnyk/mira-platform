# --- Supabase auth (production) ---
# Same values apps/crm uses. Leave unset in local dev/test -- when both are
# empty the app falls back to the local dev-auth bypass (see
# src/lib/current-agent.ts and PROGRESS-trackers.md "Notes / decisions made"
# for exactly what that bypass does and why it can never activate once these
# are set).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only -- never expose to the browser. Not used by apps/trackers today
# (no background jobs yet) but kept for parity with apps/crm's client trio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (data layer) ---
# Goals/progress-entry reads and writes go straight through `pg` against this
# connection string (see src/lib/db.ts for why -- no live Supabase/PostgREST
# environment exists to develop against yet). Point this at the same Postgres
# instance apps/crm's Supabase project and apps/lead-agent use once one
# exists; falls back to a local dev database if unset.
DATABASE_URL=

# --- Local dev-auth bypass only ---
# Agent id treated as "logged in" when NEXT_PUBLIC_SUPABASE_URL is unset.
# Ignored entirely once Supabase env vars above are set. See
# src/lib/current-agent.ts.
DEV_AGENT_ID=
