# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env / secrets
.env
.env.*
!.env.example

# next.js
.next/
out/

# build output
build/
dist/
# ...except compiled shared packages -- consumed directly by both apps'
# toolchains (Next.js bundler + tsx/NodeNext), so the compiled output is
# committed rather than requiring every consumer to run a build step first.
!packages/*/dist/
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# sqlite / local data
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# mira orchestration logs
.mira-logs/

# editor / os
.DS_Store
*.pem
.vscode/
.idea/
